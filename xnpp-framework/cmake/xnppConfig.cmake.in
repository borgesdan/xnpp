@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/xnppTargets.cmake")

check_required_components(xnpp)

function(xnpp_build_content TARGET_NAME)
    # 1. Path resolution
    if(ARGC GREATER 1)
        set(PIPELINE_CONFIG_FILE "${ARGV1}")
        get_filename_component(CONTENT_DIR "${PIPELINE_CONFIG_FILE}" DIRECTORY)
    else()
        set(CONTENT_DIR "${CMAKE_CURRENT_SOURCE_DIR}/Content")
        set(PIPELINE_CONFIG_FILE "${CONTENT_DIR}/content.json")
    endif()

    if(NOT EXISTS "${CONTENT_DIR}" OR NOT EXISTS "${PIPELINE_CONFIG_FILE}")
        message(STATUS "XNPP: Content folder or content.json not found. Skipping content pipeline build for target '${TARGET_NAME}'.")
        return()
    endif()

    # 2. Locate the installed CLI tool
    find_program(
        XNPP_CONTENT_CLI
        NAMES xnpp-content-cli
        REQUIRED
        MESSAGE "XNPP: xnpp-content-cli was not found. Was the xnpp package built with the 'content-pipeline' feature?"
    )

    # 3. Resolve the platform
    # If the user passes a 3rd argument (e.g., "CrossDesktop"), we use it. 
    # Otherwise, CMake automatically detects the native platform.
    if(ARGC GREATER 2)
        set(CONTENT_PLATFORM "${ARGV2}")
    else()
        if(WIN32)
            set(CONTENT_PLATFORM "Windows")
        elseif(APPLE)
            set(CONTENT_PLATFORM "Mac")
        elseif(UNIX AND NOT APPLE)
            set(CONTENT_PLATFORM "Linux")
        else()
            set(CONTENT_PLATFORM "CrossDesktop")
        endif()
    endif()

    set(SOURCE_CONTENT_DIR "${CONTENT_DIR}/bin/${CONTENT_PLATFORM}")
    
    # 4. Attach the command directly to the target (No extra targets = No cycles!)
    add_custom_command(TARGET ${TARGET_NAME} POST_BUILD
        # Ensure the destination folder exists
        COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:${TARGET_NAME}>/Content"
        
        # Execute the XNPP CLI FORCING the detected platform
        # This ensures the SOURCE_CONTENT_DIR folder is generated with the exact expected name.
        COMMAND ${XNPP_CONTENT_CLI} -f "${PIPELINE_CONFIG_FILE}" -p ${CONTENT_PLATFORM}
        
        # Copy from the bin/[Platform]/ folder generated by the CLI to the executable's folder
        COMMAND ${CMAKE_COMMAND} -E copy_directory "${SOURCE_CONTENT_DIR}" "$<TARGET_FILE_DIR:${TARGET_NAME}>/Content"
        
        COMMENT "XNPP: Building and copying Content Pipeline (${CONTENT_PLATFORM}) for ${TARGET_NAME}..."
        VERBATIM
    )
endfunction()